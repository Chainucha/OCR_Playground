# Copy to .env and run engines with: uv run --env-file ../.env ocr serve

# openthai-text (local CPU). Defaults to models/openthai-text after `uv run ocr download openthai-text`.
# OPENTHAI_TEXT_DIR=
# OPENTHAI_TEXT_THREADS=1

# openthai-markdown. Needs `uv run ocr download openthai-markdown` either way (the client ships with the model).
# Unset OPENTHAI_MD_BASE_URL: runs on this machine's CUDA GPU with Transformers (extra openthai-markdown-local).
# Set it: sends pages to a vLLM server (OpenAI-compatible).
# OPENTHAI_MD_DIR=
# OPENTHAI_MD_DEVICE=cuda
# OPENTHAI_MD_BASE_URL=http://localhost:8002/v1
# OPENTHAI_MD_MODEL=nemotron-parse
# OPENTHAI_MD_API_KEY=

# typhoon (vLLM, OpenAI-compatible). Remote route is the teammate's Lambda; contract TBD.
TYPHOON_BASE_URL=http://localhost:8101/v1
TYPHOON_MODEL=typhoon-ocr
TYPHOON_API_KEY=
TYPHOON_TASK_TYPE=v1.5

# Engine API
OCR_CORS_ORIGINS=http://localhost:3000

# ocr synth: folders of .ttf/.otf/.ttc fonts (separated by ; on Windows, : elsewhere). Defaults to the system font folders.
# OCR_FONT_DIRS=
